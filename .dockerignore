# Build context = package*.json, tsconfig.json, scripts/, src/ and docker-compose.hub.yml only.
node_modules
dist
data
coverage
.git
.gitignore
.worktrees
.claude
tests
docs
*.db
*.db-journal
*.db-wal
*.db-shm
# ...at any depth (a stray data dir or lab DB under src/ never reaches the image).
**/*.db*
# Never bake secrets into the image.
.env
.env.*
**/.env*
docker
docker-compose*.yml
# ...except the pull-only one, which the image ships (Dockerfile COPY).
!docker-compose.hub.yml
Dockerfile
.dockerignore
*.md
