{
  "name": "hvwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:docker": "node scripts/verify-docker.mjs",
    "gen:catalog": "tsx src/tools/gen-catalog.ts",
    "gate:catalog": "tsx src/tools/gate-catalog.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "ejs": "3.1.10",
    "express": "5.3.0",
    "htmx.org": "2.0.4",
    "parse5": "8.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/node": "22.18.11",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
