# Copy to .env (git-ignored) only if you want to override defaults.
# NEVER put real secrets, passwords or API keys here: HVWA is deliberately
# vulnerable and its labs are designed to leak configuration.

# Optional HMAC key for challenge flags (at least 16 characters). Leave blank to
# use a random secret generated on first start and kept in the data volume.
# Changing it invalidates flags issued with the previous value.
FLAG_SECRET=

# ADVANCED. Leave blank unless you know you need it. HVWA only answers
# requests whose Host is localhost, 127.0.0.1 or [::1] (any port); everything
# else gets 421. This stops malicious websites from reaching HVWA through your
# browser by DNS rebinding. Comma-separated extra hostnames/IPs to allow (no
# scheme, port or wildcard), e.g. hvwa.lab. Every name you add is one more way
# in: never add a name someone else controls. With Docker, also add it to
# server_name in docker/proxy/nginx.conf.
HVWA_ALLOWED_HOSTS=

# The platform login (one account: admin). FIRST password of the account, used
# only while no account exists yet (blank = the default "password", which you
# then change at /account/password). At least 8 characters. Throwaway only:
# never a password you use anywhere else.
HVWA_ADMIN_PASSWORD=

# The login: on | off. Blank = on (the image runs with NODE_ENV=production).
HVWA_AUTH=

# The edition `docker compose up -d --build` builds: full | lite (5 challenges).
# Blank = full.
HVWA_EDITION=
