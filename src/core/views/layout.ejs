<!doctype html>
<% const keep = typeof prefQuery === 'string' ? prefQuery : ''; -%>
<% const portalMode = typeof mode !== 'undefined' && mode === 'portal'; -%>
<% const navActive = typeof portalNav !== 'undefined' && portalNav && portalNav.active ? portalNav.active : ''; -%>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>"<% if (typeof uiTheme !== 'undefined' && (uiTheme === 'dark' || uiTheme === 'light')) { %> data-theme="<%= uiTheme %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark light">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : (labBar ? labBar.pageTitle : t('app.title')) %></title>
  <meta name="htmx-config" content='{"includeIndicatorStyles":false,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true}]}'>
  <link rel="icon" href="/static/brand/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" href="/static/brand/icon-192.png">
  <link rel="apple-touch-icon" href="/static/brand/apple-touch-icon.png">
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/splash.js"></script>
  <script src="/static/vendor/htmx.min.js"></script>
  <script src="/static/ui.js" defer></script>
</head>
<% const office = navActive === 'admin'; -%>
<body<% if (office) { %> class="office"<% } %>>
<%# The shared page shell (render.ts page()). Every value goes through the escaped output tag; only the rendered view body and the platform partials are included raw. Icons come from the /static/icons.svg sprite, so a page stays small (the XSS oracle reads whole lab pages, up to XSS_LIMITS.htmlLength). The theme toggle and the language switch are plain links (no JavaScript needed); static/ui.js only enhances. Never put an EJS tag inside an EJS comment: it breaks parsing. %>
  <div class="splash" aria-hidden="true">
    <span class="splash-ring"></span>
    <div class="splash-inner">
      <img class="splash-logo" src="/static/brand/logo.png" alt="" width="800" height="533">
      <span class="splash-loading"><span class="splash-dot"></span><span class="splash-dot"></span><span class="splash-dot"></span></span>
    </div>
  </div>
<% if (typeof welcome !== 'undefined' && welcome && platformAuth && platformAuth.signedIn) { -%>
  <div class="welcome-gate" aria-hidden="true" data-testid="welcome-gate">
    <span class="welcome-door welcome-door-left"></span><span class="welcome-door welcome-door-right"></span>
    <div class="welcome-banner">
      <span class="welcome-kicker"><%= t('auth.welcome_kicker') %></span>
      <span class="welcome-name"><%= t('auth.welcome_back').replace('{name}', () => platformAuth.user) %></span>
<% if (typeof playerRank !== 'undefined' && playerRank) { -%>
      <span class="welcome-rank"><span class="rank-seal seal" data-plate="<%= playerRank.letter.toLowerCase() %>"><%= playerRank.letter %></span><%= playerRank.plate %> · <%= playerRank.name %></span>
<% } -%>
    </div>
  </div>
<% } -%>
  <a class="skip-link" href="#main"><%= t('nav.skip') %></a>
<%# Portal mode shows no safety strip (the guild hall speaks for itself); the standalone build keeps its warning. %>
<% if (!portalMode) { -%>
  <div class="safety-banner" role="note" data-mode="standalone"><svg class="icon icon-sm" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-alert"></use></svg><span><%= t('safety.warning') %></span></div>
<% } -%>
<% if (platformAuth && platformAuth.defaultPassword) { -%>
  <div class="default-password-banner" role="alert" data-testid="default-password-banner">
    <div class="banner-inner">
      <svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-key"></use></svg>
      <span class="banner-text"><%= t(typeof portalNav !== 'undefined' && portalNav ? 'auth.temp_banner' : 'auth.default_banner') %></span>
      <a class="btn btn-xs btn-primary" href="/account/password"><%= t('auth.change_password') %></a>
    </div>
  </div>
<% } -%>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="brand">
        <img class="brand-mark brand-mark-img" src="/static/brand/icon-64.png" alt="" width="28" height="28">
        <span class="brand-name">HVWA</span>
        <span class="brand-tag"><%= t('app.guild_tag') %></span>
      </a>
<% if (!platformAuth || platformAuth.signedIn) { -%>
      <nav class="site-nav" aria-label="<%= t('nav.main') %>">
<% if (typeof portalNav !== 'undefined' && portalNav && office) { -%>
        <span class="office-tag" data-testid="office-tag"><span class="office-seal" aria-hidden="true"></span><%= t('admin.office_tag') %></span>
<% } else if (typeof portalNav !== 'undefined' && portalNav) { -%>
        <a href="/" class="nav-link" data-testid="nav-labs"<% if (navActive === 'labs') { %> aria-current="page"<% } %>><%= t('nav.labs') %></a>
        <a href="/team" class="nav-link" data-testid="nav-team"<% if (navActive === 'team') { %> aria-current="page"<% } %>><%= t('nav.team') %></a>
        <a href="/leaderboard" class="nav-link" data-testid="nav-leaderboard"<% if (navActive === 'leaderboard') { %> aria-current="page"<% } %>><%= t('nav.leaderboard') %></a>
        <a href="/shop" class="nav-link" data-testid="nav-shop"<% if (navActive === 'shop') { %> aria-current="page"<% } %>><%= t('nav.shop') %></a>
<% } else { -%>
        <a href="/" class="nav-link"><%= t('nav.districts') %></a>
        <a href="/scoreboard" class="nav-link"><%= t('nav.scoreboard') %></a>
<% } -%>
      </nav>
<% } -%>
      <div class="topbar-tools">
        <div class="lang-switch" role="group" aria-label="<%= t('nav.language') %>">
          <a href="?<%= keep %>lang=en" hreflang="en" lang="en" aria-label="<%= t('nav.lang_en') %>"<% if (lang === 'en') { %> aria-current="true"<% } %>>EN</a>
          <span class="lang-sep" aria-hidden="true">/</span>
          <a href="?<%= keep %>lang=id" hreflang="id" lang="id" aria-label="<%= t('nav.lang_id') %>"<% if (lang === 'id') { %> aria-current="true"<% } %>>ID</a>
        </div>
<% if (typeof uiTheme === 'undefined' || uiTheme !== 'light') { -%>
        <a href="?<%= keep %>theme=light" class="icon-btn theme-toggle theme-to-light" aria-label="<%= t('theme.to_light') %>" title="<%= t('theme.to_light') %>"><svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-sun"></use></svg></a>
<% } -%>
<% if (typeof uiTheme === 'undefined' || uiTheme !== 'dark') { -%>
        <a href="?<%= keep %>theme=dark" class="icon-btn theme-toggle theme-to-dark" aria-label="<%= t('theme.to_dark') %>" title="<%= t('theme.to_dark') %>"><svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-moon"></use></svg></a>
<% } -%>
        <button type="button" class="icon-btn sound-toggle" data-sound-toggle hidden aria-pressed="false" aria-label="<%= t('sound.toggle') %>" title="<%= t('sound.toggle') %>"><svg class="icon icon-sound-off" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-sound-off"></use></svg><svg class="icon icon-sound-on" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-sound-on"></use></svg></button>
<% if (typeof myLab !== 'undefined' && myLab && !office) { -%>
<%- include('my-lab') %>
<% } -%>
<% if (typeof portalNav !== 'undefined' && portalNav && portalNav.admin) { -%>
<% if (office) { -%>
        <a href="/" class="btn btn-office" data-testid="nav-hall"><svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-home"></use></svg><span class="btn-office-label"><%= t('nav.back_hall') %></span></a>
<% } else { -%>
        <a href="/adminportal" class="btn btn-office" data-testid="nav-admin"><svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-shield"></use></svg><span class="btn-office-label"><%= t('nav.admin') %></span></a>
<% } -%>
<% } -%>
<% if (platformAuth && platformAuth.signedIn) { -%>
        <details class="menu account-menu" data-testid="account-nav">
          <summary class="menu-trigger">
            <span class="sr-only"><%= t('nav.account') %>: </span><% if (typeof avatar !== 'undefined' && avatar) { %><%- include('avatar', { a: avatar, size: 'sm' }) %><% } else { %><span class="account-chip" aria-hidden="true"><%= platformAuth.user.charAt(0).toUpperCase() %></span><% } %>
            <svg class="icon icon-sm menu-caret" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-chevron-down"></use></svg>
          </summary>
          <div class="menu-panel">
            <p class="menu-meta"><%= t('auth.signed_in_as') %> <strong><%= platformAuth.user %></strong><% if (typeof playerRank !== 'undefined' && playerRank) { %> <button type="button" class="menu-rank" data-rank-open aria-haspopup="dialog" title="<%= t('rank.ladder_open') %>"><span class="rank-seal seal seal-sm" data-plate="<%= playerRank.letter.toLowerCase() %>" aria-hidden="true"><%= playerRank.letter %></span><span class="rank-name"><%= playerRank.name %></span></button><% } %></p>
<% if (typeof avatar !== 'undefined' && avatar) { -%>
            <a class="menu-item" href="/adventurer" data-testid="nav-adventurer"><svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-user"></use></svg><%= t('nav.my_adventurer') %></a>
<% } -%>
            <a class="menu-item" href="/account/password"><svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-key"></use></svg><%= t('auth.change_password') %></a>
            <form method="post" action="/logout" class="logout-form"><input type="hidden" name="_csrf" value="<%= platformAuth.csrf %>"><button type="submit" class="menu-item menu-item-danger" data-testid="logout"><svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-log-out"></use></svg><%= t('auth.logout') %></button></form>
          </div>
        </details>
<% } -%>
      </div>
    </div>
  </header>
  <main class="content<%= labBar ? ' content-lab' : '' %>" id="main" tabindex="-1">
<% if (!labBar && typeof crumbs !== 'undefined' && crumbs && crumbs.length > 0) { -%>
    <nav class="crumbs-nav" aria-label="<%= t('nav.breadcrumb') %>">
      <ol class="crumbs">
<% crumbs.forEach(function (c, i) { -%>
        <li><% if (c.href && i < crumbs.length - 1) { %><a href="<%= c.href %>"><%= c.label %></a><% } else { %><span aria-current="page"><%= c.label %></span><% } %></li>
<% }); -%>
      </ol>
    </nav>
<% } -%>
<% if (labBar) { -%>
    <nav class="lab-bar" data-testid="lab-bar" aria-label="<%= t('lab.bar_label') %>" data-level="<%= labBar.level %>">
      <div class="lab-bar-top">
        <ol class="crumbs" aria-label="<%= t('nav.breadcrumb') %>">
          <li><a href="/"><%= t('nav.home') %></a></li>
          <li><a href="<%= labBar.district.href %>"><%= labBar.district.name %></a></li>
          <li><a href="<%= labBar.backHref %>"><%= labBar.id %></a></li>
          <li><span aria-current="page"><%= t('lab.crumb') %></span></li>
        </ol>
        <div class="lab-bar-actions">
<% if (labBar.resetAction) { -%>
          <form method="post" action="<%= labBar.resetAction %>" class="lab-restart"><button type="submit" class="btn btn-secondary btn-sm" data-testid="lab-restart" title="<%= t('lab.restart_help') %>"><svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-rotate"></use></svg><%= labBar.resetLabel %></button></form>
<% } -%>
          <a class="lab-bar-back" href="<%= labBar.backHref %>"><%= t('challenge.back') %></a>
        </div>
      </div>
      <div class="lab-bar-head">
        <span class="challenge-id"><%= labBar.id %></span>
        <span class="lab-bar-title"><%= labBar.title %></span>
        <span class="badge lab-bar-level level-badge" title="<%= t('lab.current_level') %>" data-testid="lab-level" data-level="<%= labBar.level %>"><%= labBar.levelLabel %></span>
      </div>
      <p class="lab-bar-summary"><%= labBar.summary %></p>
      <div class="lab-bar-controls">
        <div class="lab-bar-switch">
          <ul class="lab-levels" aria-label="<%= t('lab.switch_level') %>">
<% labBar.levels.forEach(function (l) { -%>
            <li><a href="<%= l.href %>" data-level="<%= l.id %>"<% if (l.current) { %> aria-current="page" class="current"<% } %>><%= l.label %></a></li>
<% }); -%>
          </ul>
          <p class="lab-level-meaning"><span class="lab-level-now"><%= t('lab.you_are_on') %> <%= labBar.levelLabel %>:</span> <%= labBar.levelMeaning %></p>
        </div>
      </div>
<% if (labBar.restartNotice) { -%>
      <p class="lab-restart-notice" data-testid="lab-restart-notice" role="status"><%= labBar.restartNotice %></p>
<% } -%>
    </nav>
<% } -%>
    <%- body %>
<% if (typeof simPanel !== 'undefined' && simPanel) { -%>
<%- include('sim-panel') %>
<% } -%>
  </main>
  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-brand"><svg class="icon icon-sm" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-crest"></use></svg>HVWA</span>
      <span><%= t(portalMode ? 'app.portal_tagline' : 'app.tagline') %></span>
<% if (!portalMode) { -%>
      <span><%= t('app.footer') %></span>
<% } -%>
      <span class="music-credit"><%= t('app.music_credit') %></span>
    </div>
  </footer>
  <div id="toasts" class="toasts" data-dismiss="<%= t('range.toast_dismiss') %>"></div>
<%# The submit-result popup (htmx enhancement). It starts closed: no `open` attribute, so it is not on screen until
     ui.js opens it from the data-modal-* attributes on a submit-result fragment. Values are filled by ui.js (textContent),
     so the markup itself stays inert and CSP-clean. %>
  <dialog id="confirm-dialog" class="confirm-dialog" data-kind="" data-title="<%= t('confirm.title') %>" data-ok="<%= t('confirm.ok') %>" aria-labelledby="confirm-title" aria-describedby="confirm-message">
    <div class="confirm-slip">
      <span class="confirm-seal" aria-hidden="true"></span>
      <h2 id="confirm-title" class="confirm-title"></h2>
      <p id="confirm-message" class="confirm-message"></p>
      <div class="confirm-actions"><button type="button" class="btn btn-secondary" data-confirm-cancel><%= t('confirm.cancel') %></button><button type="button" class="btn btn-primary" data-confirm-ok></button></div>
    </div>
  </dialog>
  <dialog id="solve-dialog" class="solve-dialog" data-variant="" aria-labelledby="solve-title" aria-describedby="solve-message">
    <div class="solve-slip">
      <div class="solve-confetti" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
      <span class="solve-seal" aria-hidden="true"></span>
      <h2 id="solve-title" class="solve-title"></h2>
      <p id="solve-message" class="solve-message"></p>
      <p class="solve-points" hidden><span class="solve-points-figure"></span><span class="solve-points-unit"><%= t('range.modal_points') %></span></p>
      <div class="solve-fact" hidden>
        <span class="solve-fact-label"><%= t('range.modal_field_note') %></span>
        <p class="solve-fact-text"></p>
      </div>
      <button type="button" class="btn btn-primary solve-continue"><%= t('range.modal_continue') %></button>
    </div>
  </dialog>
<% if (typeof rankLadder !== 'undefined' && rankLadder && !office) { -%>
  <dialog id="rank-ladder" class="rank-ladder" aria-labelledby="rank-ladder-title" data-testid="rank-ladder">
<% var ladderHere = rankLadder.filter(function (r) { return r.state === 'here'; })[0]; var ladderNext = rankLadder.filter(function (r) { return r.state === 'ahead'; })[0]; var ladderPoints = ladderNext ? ladderNext.min - ladderNext.need : (ladderHere ? ladderHere.min : 0); -%>
    <div class="ladder-scroll">
      <button type="button" class="icon-btn ladder-close" data-ladder-close aria-label="<%= t('rank.ladder_close') %>"><svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-x"></use></svg></button>
      <header class="ladder-head">
        <p class="ladder-eyebrow"><%= t('rank.ladder_eyebrow') %></p>
        <h2 class="ladder-title" id="rank-ladder-title"><%= t('rank.ladder_title') %></h2>
        <p class="ladder-lead"><%= t('rank.ladder_lead') %></p>
<% if (ladderHere) { -%>
        <div class="ladder-progress">
          <span class="ladder-progress-now"><span class="rank-seal seal seal-sm" data-plate="<%= ladderHere.letter.toLowerCase() %>" aria-hidden="true"><%= ladderHere.letter %></span><%= ladderHere.name %> · <%= ladderPoints %> G</span>
<% if (ladderNext) { -%>
          <progress class="progress progress-gold ladder-bar" max="<%= ladderNext.min - ladderHere.min %>" value="<%= ladderPoints - ladderHere.min %>"><%= ladderPoints %> / <%= ladderNext.min %></progress>
          <span class="ladder-progress-next"><%= t('rank.ladder_next').replace('{rank}', function () { return ladderNext.letter + ' · ' + ladderNext.name; }).replace('{n}', ladderNext.need) %></span>
<% } else { -%>
          <span class="ladder-progress-next"><%= t('rank.max') %></span>
<% } -%>
        </div>
<% } -%>
      </header>
      <ol class="ladder">
<% rankLadder.slice().reverse().forEach(function (r) { -%>
        <li class="ladder-rung" data-state="<%= r.state %>" data-rank="<%= r.letter %>"<% if (r.state === 'here') { %> aria-current="step"<% } %>>
          <div class="rung-card">
<% if (r.state === 'here') { -%>
            <span class="rung-you"><%= t('rank.ladder_here') %></span>
<% } -%>
            <span class="rank-plate ladder-plate" data-plate="<%= r.letter.toLowerCase() %>" aria-hidden="true"><span class="plate-letter"><%= r.letter %></span><span class="plate-metal"><%= r.plate %></span></span>
            <p class="ladder-rank-name"><%= r.name %></p>
            <p class="ladder-min"><span class="coin" aria-hidden="true"></span><%= r.min %> G</p>
            <%- include('../../range/views/nameplate', { name: platformAuth.user, letter: r.letter }) %>
            <p class="ladder-perk"><%= t('rank.perk.' + r.letter.toLowerCase()) %></p>
            <span class="ladder-state"><% if (r.state === 'here') { %><%= t('rank.ladder_here') %><% } else if (r.state === 'done') { %><%= t('rank.ladder_done') %><% } else { %><%= t('rank.ladder_need').replace('{n}', r.need) %><% } %></span>
          </div>
          <span class="rung-pillar" aria-hidden="true"></span>
        </li>
<% }); -%>
      </ol>
    </div>
  </dialog>
<% } -%>
<% if (portalMode && platformAuth && platformAuth.signedIn && !office) { -%>
  <dialog id="tour" class="tour" aria-label="<%= t('tour.label') %>" data-step-label="<%= t('tour.step') %>" data-next="<%= t('tour.next') %>" data-done="<%= t('tour.done') %>">
    <div class="tour-spot" data-tour-spot aria-hidden="true"></div>
    <div class="tour-box" data-tour-box>
      <div class="tour-mira" aria-hidden="true"><img class="mira-art" data-tour-art src="/static/art/mira-smile.webp" alt="" width="560" height="690" decoding="async"></div>
      <div class="dialogue tour-dialogue">
        <p class="dialogue-name"><span class="dialogue-speaker"><%= t('mira.name') %></span><span class="dialogue-role"><%= t('mira.role') %></span><span class="tour-count" data-tour-count></span></p>
        <p class="dialogue-text" data-tour-text aria-live="polite"></p>
        <span class="dialogue-more" aria-hidden="true"></span>
        <div class="dialogue-actions">
          <button type="button" class="btn btn-ghost btn-sm" data-tour-skip><%= t('tour.skip') %></button>
          <button type="button" class="btn btn-secondary btn-sm" data-tour-back><%= t('tour.back') %></button>
          <button type="button" class="btn btn-primary btn-sm" data-tour-next><%= t('tour.next') %></button>
        </div>
      </div>
    </div>
  </dialog>
<% } -%>
</body>
</html>
