<!doctype html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'id' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : t('app.title') %></title>
  <meta name="htmx-config" content='{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true}]}'>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/vendor/htmx.min.js"></script>
</head>
<body>
  <div class="safety-banner" role="alert"><%= t('safety.warning') %></div>
  <header class="site-header">
    <a href="/" class="brand"><%= t('app.title') %></a>
    <nav class="site-nav">
      <a href="/"><%= t('nav.districts') %></a>
      <a href="/scoreboard"><%= t('nav.scoreboard') %></a>
    </nav>
    <span class="lang-switch">
      <a href="?lang=id">ID</a> · <a href="?lang=en">EN</a>
    </span>
  </header>
  <main class="content">
    <%- body %>
  </main>
</body>
</html>
