<%# GK-11 message page: what a Pilgrim-ID or Citadel step answered. Lab content is English by design. Every value goes through the escaped output tag. Never put an EJS tag inside an EJS comment: it breaks parsing. %>
<section class="lab">
  <h1>Citadel</h1>
<% if (result.text) { -%>
  <p class="lab-message <%= result.ok ? 'lab-success' : 'lab-error' %>" role="status" data-testid="lab-message"><%= result.text %></p>
<% } -%>
  <p class="lab-note"><a href="<%= base %>?level=<%= level %>">Back to Citadel</a></p>
</section>
