<%# GK-18 lab view. Lab content is English by design. Every value goes through the escaped output tag. Never put an EJS tag inside an EJS comment: it breaks parsing. %>
<section class="lab">
  <h1>Citadel Gate - Roles</h1>
  <p class="lab-note">Your account: <code><%= account.username %></code> / <code><%= account.password %></code>. Target: the <a href="<%= base %>/admin?level=<%= level %>">admin page</a>. The lab cookie is <code><%= cookie %></code><% if (httpOnly) { %> (HttpOnly: edit it in the browser devtools storage panel, or send it with <code>curl -b</code>)<% } else { %> (you can read and edit it in the browser devtools, or send it with <code>curl -b</code>)<% } %>.</p>
<% if (who) { -%>
  <p class="lab-note" data-testid="identity">Current identity: <%= who.user %> (role: <%= who.role %>)</p>
<% } -%>
  <form method="post">
    <label>Username <input name="username" type="text" autocomplete="off" spellcheck="false" value="<%= username %>"></label>
    <label>Password <input name="password" type="text" autocomplete="off" spellcheck="false" value="<%= password %>"></label>
    <button type="submit">Sign in</button>
  </form>
<% if (result) { -%>
  <p class="lab-message <%= result.ok ? 'lab-success' : 'lab-error' %>" role="status" data-testid="lab-message"><%= result.text %></p>
<% } -%>
</section>
