<%# GK-17 admin page. Lab content is English by design. Every value goes through the escaped output tag. Never put an EJS tag inside an EJS comment: it breaks parsing. %>
<section class="lab">
  <h1>Admin area</h1>
<% if (admin) { -%>
  <p class="lab-message lab-success" role="status" data-testid="lab-message">Citadel admin console. <%= note %></p>
<% } else { -%>
  <p class="lab-message lab-error" role="status" data-testid="lab-message">Admin only. Present the citadel admin's session cookie.</p>
<% } -%>
  <p class="lab-note"><a href="<%= base %>?level=<%= level %>">Back to the sign-in page</a></p>
</section>
