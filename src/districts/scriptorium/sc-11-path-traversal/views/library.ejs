<%# SC-11 scroll library. Lab content is English by design. Every value goes through the escaped output tag. Never put an EJS tag inside an EJS comment: it breaks parsing. %>
<section class="lab">
  <h1>Scroll Library</h1>
  <p class="lab-note">You are signed in as <code>pilgrim</code>. Each public scroll has a download link, <code><%= base %>/download?file=&lt;name&gt;</code> (add <code>&amp;level=<%= level %></code>), and the server reads the scroll named in the link from its public directory. The archive also keeps a vault that is not for everyone.</p>
  <ul class="library-scrolls" data-testid="scrolls">
<% for (const s of scrolls) { -%>
    <li><a href="<%= base %>/download?level=<%= level %>&amp;file=<%= s %>"><%= s %></a></li>
<% } -%>
  </ul>
  <form method="post">
    <label>Scroll name <input name="file" type="text" value="<%= file %>" autocomplete="off"></label>
    <button type="submit">Show on this page</button>
  </form>
<% if (result) { -%>
  <p class="lab-message <%= result.ok ? 'lab-success' : 'lab-error' %>" role="status" data-testid="lab-message"><%= result.text %></p>
<% } -%>
<% if (contents !== null) { -%>
  <pre data-testid="contents"><%= contents %></pre>
<% } -%>
  <%- include('../../../_shared/views/curl-note', { curl: curl }) %>
</section>
