<%# Archive API endpoint table: method, path, auth, example. Include it with the data of apiView (endpoints, base, served). Every value goes through the escaped output tag. Never put an EJS tag inside an EJS comment: it breaks parsing. %>
<% if (endpoints.length > 0) { -%>
<table class="lab-table" data-testid="endpoints">
  <thead><tr><th>Method</th><th>Path</th><th>Auth</th><th>What it does</th><th>Example</th></tr></thead>
  <tbody>
<% endpoints.forEach(function (e) { -%>
    <tr data-method="<%= e.method %>" data-path="<%= e.path %>" data-auth="<%= e.auth %>">
      <td><code><%= e.method %></code></td>
      <td><code><%= base %><%= e.path %></code></td>
      <td><%= e.auth === 'bearer' ? 'Bearer key' : 'none' %></td>
      <td><%= e.description %></td>
      <td><% if (e.href) { %><a href="<%= e.href %>"><code><%= e.example %></code></a><% } else if (e.example) { %><code><%= e.example %></code><% } %></td>
    </tr>
<% }); -%>
  </tbody>
</table>
<p class="lab-note">Add <code>?level=<%= served %></code> to a URL in your browser; a tool sends the level the same way.</p>
<% } -%>
