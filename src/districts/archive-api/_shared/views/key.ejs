<%# Archive API: the player's own API key. Include it with the data of apiView (apiKey). Every value goes through the escaped output tag. Never put an EJS tag inside an EJS comment: it breaks parsing. %>
<section class="lab-note" data-testid="key-box">
  <h2>Your API key</h2>
  <p>Send it as <code>Authorization: Bearer &lt;key&gt;</code>: <code data-testid="api-key"><%= apiKey %></code></p>
  <p>It belongs to you at this level. Another player, and another level, have different keys.</p>
</section>
