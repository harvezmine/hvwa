<%# RM-02 lab view. Lab content is English by design. The partials live in relic-market/_shared/views. Every value goes through the escaped output tag. Never put an EJS tag inside an EJS comment: it breaks parsing. %>
<section class="lab">
  <h1>Relic Market stock checker</h1>
  <p class="lab-note">You are browsing as a guest. Your region: <code><%= region %></code></p>
<%- include('../../_shared/views/message') %>
  <p class="lab-note">Staff codes live in the <code>staff_codes</code> table, in its <code>code</code> column; this checker reads the <code>stock</code> table.</p>
  <h2>Check stock</h2>
  <form method="post">
    <input type="hidden" name="intent" value="check">
    <label>SKU <input name="sku" type="text" autocomplete="off" spellcheck="false" value="<%= sku %>"></label>
    <button type="submit">Check</button>
  </form>
  <p class="lab-note">Products: <% products.forEach(function (p, i) { %><%= i === 0 ? '' : ', ' %><code><%= p[0] %></code> (<%= p[1] %>)<% }); %>.</p>
  <h2>Your region</h2>
  <form method="post">
    <input type="hidden" name="intent" value="region">
    <label>Region <select name="region"><% regions.forEach(function (r) { %><option value="<%= r %>"<%= r === region ? ' selected' : '' %>><%= r %></option><% }); %></select></label>
    <button type="submit">Set region</button>
  </form>
<%- include('../../_shared/views/staff-code', { noun: 'staff code', length: 8, code: code }) %>
<%- include('../../../_shared/views/curl-note', { curl: curl }) %>
<%- include('../../_shared/views/endpoints') %>
</section>
