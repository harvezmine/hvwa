<%# Redeem form of the blind SQL labs (see staff-code.ts): intent redeem, a code text field that keeps what was typed. Data: noun, length, code. Every value goes through the escaped output tag. Never put an EJS tag inside an EJS comment: it breaks parsing. %>
  <h2>Redeem a <%= noun %></h2>
  <form method="post">
    <input type="hidden" name="intent" value="redeem">
    <label>Redeem <%= noun %> (<%= length %> characters) <input name="code" type="text" autocomplete="off" spellcheck="false" value="<%= code %>"></label>
    <button type="submit">Redeem</button>
  </form>
