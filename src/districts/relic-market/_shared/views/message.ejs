<%# The lab message of a Relic Market page (result: ok + text, or null). Every value goes through the escaped output tag. Never put an EJS tag inside an EJS comment: it breaks parsing. %>
<% if (result) { -%>
  <p class="lab-message <%= result.ok ? 'lab-success' : 'lab-error' %>" role="status" data-testid="lab-message"><%= result.text %></p>
<% } -%>
