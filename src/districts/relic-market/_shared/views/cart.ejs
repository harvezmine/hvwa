<%# Relic Market cart: lines and totals exactly as the lab computed them (a line the lab could not price shows its note), and the checkout form. Hooks: tr data-sku data-qty data-line data-kind, data-testid cart-total. Every value goes through the escaped output tag. Never put an EJS tag inside an EJS comment: it breaks parsing. %>
  <h2>Your cart</h2>
<% if (cart.rows.length === 0) { -%>
  <p class="lab-note">Nothing in your cart yet.</p>
<% } else { -%>
  <table class="shop-cart">
    <thead><tr><th>Item</th><th>Unit price</th><th>Quantity</th><th>Line total</th></tr></thead>
    <tbody>
<% cart.rows.forEach(function (r) { -%>
      <tr data-sku="<%= r.sku %>" data-qty="<%= r.qty %>" data-line="<%= r.line ? r.line.cents : '' %>" data-kind="<%= r.kind %>"><td><%= r.name %><% if (r.kind === 'return') { %> (return for store credit)<% } %></td><td><%= r.unit.text %></td><td>× <%= r.qty %></td><td><%= r.line ? r.line.text : r.note %></td></tr>
<% }); -%>
    </tbody>
    <tfoot><tr><th colspan="3">Total</th><td data-testid="cart-total" data-cents="<%= cart.total ? cart.total.cents : '' %>"><%= cart.total ? cart.total.text : cart.note %></td></tr></tfoot>
  </table>
  <form method="post">
    <input type="hidden" name="intent" value="checkout">
    <button type="submit">Check out</button>
  </form>
<% } -%>
