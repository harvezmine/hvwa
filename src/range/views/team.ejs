<%# Team page (src/range/teams.ts): create/join when the user has no team, else the team's name, join code, members,
   team bounty and Leave. A plain form page (no JavaScript): CSRF on every POST, every value through the escaped
   output tag. Never put an EJS tag inside an EJS comment: it breaks parsing. %>
<header class="page-head">
  <div class="board-head">
    <svg class="icon laurel" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-laurel"></use></svg>
    <h1 class="page-title"><%= t('team.title') %></h1>
  </div>
  <p class="page-lead"><%= t('team.lead') %></p>
</header>
<% if (error) { -%>
<p class="result result-bad" role="alert" data-testid="team-error"><%= error %></p>
<% } -%>
<% if (notice) { -%>
<p class="result result-ok" role="status" data-testid="team-notice"><%= notice %></p>
<% } -%>
<% if (!hasTeam) { -%>
<section class="team-forms" aria-label="<%= t('team.forms_label') %>">
  <div class="card">
    <h2 class="board-title"><%= t('team.create_title') %></h2>
    <p class="muted"><%= t('team.create_lead') %></p>
    <form method="post" action="/team/create" class="team-form" data-testid="team-create-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="team-name"><%= t('team.name_label') %></label>
        <input id="team-name" type="text" name="name" minlength="3" maxlength="32" required autocomplete="off"
          placeholder="<%= t('team.name_placeholder') %>" aria-describedby="team-name-help">
        <p class="help" id="team-name-help"><%= t('team.name_help') %></p>
      </div>
      <button type="submit" class="btn btn-primary" data-testid="team-create-submit"><%= t('team.create_button') %></button>
    </form>
  </div>
  <div class="card">
    <h2 class="board-title"><%= t('team.join_title') %></h2>
    <p class="muted"><%= t('team.join_lead') %></p>
    <form method="post" action="/team/join" class="team-form" data-testid="team-join-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="team-code"><%= t('team.code_label') %></label>
        <input id="team-code" type="text" name="code" minlength="8" maxlength="8" required autocomplete="off"
          autocapitalize="characters" spellcheck="false" placeholder="<%= t('team.code_placeholder') %>" aria-describedby="team-code-help">
        <p class="help" id="team-code-help"><%= t('team.code_help') %></p>
      </div>
      <button type="submit" class="btn btn-primary" data-testid="team-join-submit"><%= t('team.join_button') %></button>
    </form>
  </div>
</section>
<% } else { -%>
<section class="card team-sheet party-banner" aria-labelledby="team-name-heading" data-testid="team-sheet">
  <div class="board-head">
    <h2 class="board-title" id="team-name-heading" data-testid="team-name"><%= team.name %></h2>
    <span class="board-count"><%= t('team.score').replace('{n}', team.score) %></span>
  </div>
  <dl class="team-meta">
    <div class="team-meta-row">
      <dt><%= t('team.join_code') %></dt>
      <dd class="mono" data-testid="team-join-code"><%= team.joinCode %></dd>
    </div>
  </dl>
  <h3 class="team-subhead"><%= t('team.members_title') %></h3>
  <ul class="team-members" data-testid="team-members">
<% team.members.forEach(function (m) { -%>
    <li data-user="<%= m.username %>"><span class="rank-seal seal seal-sm" aria-hidden="true"></span><%= m.username %><% if (m.isSelf) { %> <span class="you"><%= t('leaderboard.you') %></span><% } %></li>
<% }); -%>
  </ul>
  <form method="post" action="/team/leave" class="team-leave" data-testid="team-leave-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button type="submit" class="btn btn-secondary" data-testid="team-leave-submit"><%= t('team.leave_button') %></button>
  </form>
</section>
<% } -%>
