<%# Range catalog (src/range/catalog.ts): the Guild Hall. A torch-lit hall wall with the greeting on a hanging tapestry
   beside the Adventurer's Licence (portrait, rank plate, gold, bounties done, experience and board bars), the "quest in hand" note, then the bounty boards: one wooden board per guild track,
   laid out as a horizontal scroll-snap carousel. The hanging signs and each board's prev/next links are plain anchors
   (#board-<track>), so the boards switch without JavaScript; static/ui.js only smooths the slide and tracks the active
   sign. Hooks: range-score, range-solved, range-rank, range-progress, range-rank-progress, continue-lab (data-state),
   range-filters, board-sign-<track>, board-<track>, lab-card (data-lab, data-difficulty, data-solved, data-theme).
   Every value goes through the escaped output tag. Never put an EJS tag inside an EJS comment: it breaks parsing. %>
<header class="hall-stage">
  <span class="torch torch-left" aria-hidden="true"><span class="torch-flame"></span></span>
  <span class="torch torch-right" aria-hidden="true"><span class="torch-flame"></span></span>
  <div class="hall-banner">
    <span class="banner-rod" aria-hidden="true"></span>
    <div class="banner-cloth">
      <svg class="banner-crest" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-crest"></use></svg>
      <p class="eyebrow banner-eyebrow"><%= t('range.eyebrow') %></p>
      <h1 class="gh-display"><%= t('range.hero_title') %></h1>
      <p class="gh-lead"><%= t('range.catalog_lead') %></p>
    </div>
  </div>
  <aside class="guild-card licence" aria-labelledby="guild-card-name">
    <div class="licence-head"><span><%= t('range.licence') %></span><span class="licence-no"><%= t('range.licence_no') %> <%= typeof platformAuth !== 'undefined' && platformAuth ? String(platformAuth.userId).padStart(4, '0') : '0000' %></span></div>
    <div class="guild-card-top">
      <a class="licence-avatar" href="/adventurer" title="<%= t('nav.my_adventurer') %>" data-testid="licence-avatar"><span class="sr-only"><%= t('nav.my_adventurer') %></span><%- include('../../core/views/avatar', { a: avatar, size: 'lg' }) %></a>
      <div class="guild-card-id">
        <span class="guild-card-label"><%= t('rank.label') %></span>
        <%- include('nameplate', { name: username, letter: rank.letter, size: 'lg', nameId: 'guild-card-name' }) %>
        <span class="guild-card-title" data-testid="range-rank"><span class="rank-name"><%= rank.name %></span><span class="sr-only"> · <%= rank.letter %></span> · <%= rank.plate %></span>
      </div>
      <button type="button" class="rank-plate rank-plate-btn" data-plate="<%= rank.letter.toLowerCase() %>" data-rank-open aria-haspopup="dialog" title="<%= t('rank.ladder_open') %>" data-testid="rank-open"><span class="sr-only"><%= t('rank.ladder_open') %></span><span class="plate-letter" aria-hidden="true"><%= rank.letter %></span><span class="plate-metal" aria-hidden="true"><%= rank.plate %></span></button>
    </div>
    <dl class="licence-stats">
      <div class="licence-stat">
        <dt><%= t('range.your_score') %></dt>
        <dd><span class="coin" aria-hidden="true"></span><span data-testid="range-score"><%= score %></span> <span class="stat-of"><%= t('range.gold') %></span></dd>
      </div>
      <div class="licence-stat">
        <dt><%= t('range.contracts_sealed') %></dt>
        <dd data-testid="range-solved"><%= solved %> <span class="stat-of"><%= t('home.of').replace('{n}', total) %></span></dd>
      </div>
    </dl>
    <div class="licence-bar">
      <div class="progress-label"><span><%= t('range.exp') %> · <%= rank.points %> / <%= rank.nextMinPoints %> <%= t('range.gold') %></span><span><% if (rank.maxed) { %><%= t('rank.max') %><% } else { %><%= t('rank.to').replace('{rank}', rank.nextLetter + ' · ' + rank.nextName) %><% } %></span></div>
      <progress class="progress progress-gold" data-testid="range-rank-progress" max="<%= rank.nextMinPoints %>" value="<%= rank.points %>"><%= rank.points %> / <%= rank.nextMinPoints %></progress>
    </div>
    <div class="licence-bar">
      <div class="progress-label"><span><%= t('range.progress_label') %></span><span><%= solved %>/<%= total %></span></div>
      <progress class="progress progress-board" data-testid="range-progress" max="<%= total %>" value="<%= solved %>"><%= solved %>/<%= total %></progress>
    </div>
    <p class="licence-foot"><span class="licence-seal" aria-hidden="true"></span><%= t('range.licence_seal') %></p>
  </aside>
<%
  var miraLines = [];
  var nameFn = function () { return username; };
  if (needsAvatar) miraLines.push({ pose: 'point', text: t('avatar.invite').replace('{name}', nameFn) });
  if (madeAvatar) miraLines.push({ pose: 'cheer', text: t('avatar.made').replace('{class}', function () { return t('hero.' + avatar.hero + '.name'); }) });
  if (!needsAvatar && !madeAvatar) miraLines.push({ pose: 'smile', text: (solved === 0 ? t('mira.hello_new') : t('mira.hello')).replace('{name}', nameFn) });
  if (continueLab) miraLines.push({ pose: 'point', text: t('mira.continue').replace('{title}', function () { return continueLab.title; }) });
  if (solved === 0) miraLines.push({ pose: 'point', text: t('mira.first') });
  else if (solved < total) miraLines.push({ pose: 'cheer', text: t('mira.progress').replace('{n}', solved).replace('{left}', total - solved) });
  else miraLines.push({ pose: 'cheer', text: t('mira.done') });
  if (!rank.maxed) miraLines.push({ pose: 'cheer', text: t('mira.rank').replace('{gold}', Math.max(0, rank.nextMinPoints - rank.points)).replace('{rank}', function () { return rank.nextLetter + ' · ' + rank.nextName; }) });
  miraLines.push({ pose: 'think', text: t('mira.whisper') });
  miraLines.push({ pose: 'point', text: t('mira.briefing') });
  miraLines.push({ pose: 'cheer', text: t('mira.cheer').replace('{name}', nameFn) });
-%>
  <div class="reception" data-reception>
    <button type="button" class="mira-stand" data-mira-poke tabindex="-1" aria-hidden="true">
      <img class="mira-art" data-mira-art src="/static/art/mira-<%= miraLines[0].pose %>.webp" alt="" width="560" height="690" decoding="async">
    </button>
    <div class="dialogue" data-dialogue>
      <p class="dialogue-name"><span class="dialogue-speaker"><%= t('mira.name') %></span><span class="dialogue-role"><%= t('mira.role') %></span></p>
      <p class="dialogue-text" data-dialogue-text aria-live="polite"><%= miraLines[0].text %></p>
      <ol class="dialogue-lines" data-dialogue-lines hidden>
<% miraLines.forEach(function (l) { -%>
        <li data-pose="<%= l.pose %>"><%= l.text %></li>
<% }); -%>
      </ol>
      <span class="dialogue-more" aria-hidden="true"></span>
      <div class="dialogue-actions" data-dialogue-actions hidden>
<% if (needsAvatar) { -%>
        <a class="btn btn-primary btn-sm" href="/adventurer" data-testid="reception-create"><svg class="icon icon-sm" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-quill"></use></svg><%= t('avatar.invite_go') %></a>
<% } -%>
        <button type="button" class="btn btn-secondary btn-sm" data-dialogue-next><%= t('mira.next') %><svg class="icon icon-sm" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-chevron-right"></use></svg></button>
        <button type="button" class="btn btn-primary btn-sm" data-tour-start><svg class="icon icon-sm" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-map"></use></svg><%= t('mira.tour') %></button>
      </div>
    </div>
    <span class="counter" aria-hidden="true"></span>
  </div>
</header>
<% if (continueLab) { -%>
<a class="continue-slip" href="<%= continueLab.href %>" data-testid="continue-lab" data-state="<%= continueLab.state %>">
  <span class="seal" aria-hidden="true"><svg class="icon icon-sm" focusable="false"><use href="/static/icons.svg#<%= continueLab.icon %>"></use></svg></span>
  <span class="continue-body">
    <span class="continue-eyebrow"><%= t('range.continue_hero') %></span>
    <span class="continue-app"><%= continueLab.title %></span>
    <span class="continue-meta"><%= continueLab.app %> · <%= continueLab.stateLabel %><% if (continueLab.minutesLeft > 0) { %> · <%= t('range.time_left').replace('{n}', continueLab.minutesLeft) %><% } %></span>
  </span>
  <span class="continue-go"><%= t('range.resume') %></span>
</a>
<% } -%>
<section class="boards" data-boards aria-labelledby="board-title">
  <div class="board-head">
    <h2 class="board-title" id="board-title"><%= t('range.mission_board') %></h2>
    <span class="board-count"><%= t('range.mission_count').replace('{n}', total) %></span>
  </div>
  <nav class="board-signs" aria-label="<%= t('range.tracks_label') %>">
<% boards.forEach(function (b, i) { -%>
    <a class="board-sign<%= b.total === 0 && !b.quest ? ' is-soon' : '' %>" href="#board-<%= b.id %>" data-board-link="<%= i %>" data-testid="board-sign-<%= b.id %>"<% if (i === 0) { %> aria-current="true"<% } %>><span class="board-sign-name"><%= b.name %></span><span class="board-sign-sub"><%= b.quest && b.total === 0 ? t('quest.grand') : b.total === 0 ? t('range.track_soon') : b.done + '/' + b.total %></span></a>
<% }); -%>
  </nav>
  <form method="get" action="/" class="range-filters" data-testid="range-filters">
    <div class="field field-search">
      <label for="f-q"><%= t('range.search') %></label>
      <input id="f-q" type="search" name="q" value="<%= filter.q %>" placeholder="<%= t('range.search_placeholder') %>">
    </div>
    <div class="field">
      <label for="f-category"><%= t('range.filter_category') %></label>
      <select id="f-category" name="category">
        <option value=""><%= t('range.filter_all') %></option>
<% categories.forEach(function (c) { -%>
        <option value="<%= c %>"<% if (c === filter.category) { %> selected<% } %>><%= c %></option>
<% }); -%>
      </select>
    </div>
    <div class="field">
      <label for="f-difficulty"><%= t('range.filter_difficulty') %></label>
      <select id="f-difficulty" name="difficulty">
        <option value=""><%= t('range.filter_all') %></option>
<% difficulties.forEach(function (d) { -%>
        <option value="<%= d %>"<% if (d === filter.difficulty) { %> selected<% } %>><%= t('range.difficulty.' + d) %></option>
<% }); -%>
      </select>
    </div>
    <div class="field">
      <label for="f-show"><%= t('range.filter_show') %></label>
      <select id="f-show" name="show">
        <option value="all"><%= t('range.filter_all') %></option>
        <option value="todo"<% if (filter.show === 'todo') { %> selected<% } %>><%= t('range.show_todo') %></option>
        <option value="done"<% if (filter.show === 'done') { %> selected<% } %>><%= t('range.show_done') %></option>
      </select>
    </div>
    <div class="field">
      <label for="f-sort"><%= t('range.sort') %></label>
      <select id="f-sort" name="sort">
        <option value="app"<% if (filter.sort === 'app') { %> selected<% } %>><%= t('range.sort_app') %></option>
        <option value="difficulty"<% if (filter.sort === 'difficulty') { %> selected<% } %>><%= t('range.sort_difficulty') %></option>
        <option value="solved"<% if (filter.sort === 'solved') { %> selected<% } %>><%= t('range.sort_solved') %></option>
      </select>
    </div>
    <button type="submit" class="btn btn-secondary"><%= t('range.filter_apply') %></button>
  </form>
<% if (cards.length === 0) { -%>
  <div class="empty">
    <svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-empty-scroll"></use></svg>
    <p><%= t('range.empty') %></p>
    <a class="btn btn-secondary" href="/" data-testid="empty-clear"><%= t('range.empty_action') %></a>
  </div>
<% } -%>
  <div class="boards-viewport">
    <button type="button" class="board-nav board-nav-prev" data-board-prev hidden aria-label="<%= t('range.board_prev') %>"><svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-arrow-left"></use></svg></button>
    <div class="boards-track" data-boards-track>
<% boards.forEach(function (b, i) { var prev = boards[(i + boards.length - 1) % boards.length], next = boards[(i + 1) % boards.length]; -%>
      <section class="board-slide" id="board-<%= b.id %>" data-board="<%= b.id %>" data-testid="board-<%= b.id %>" aria-labelledby="board-<%= b.id %>-name">
        <header class="board-plank">
          <a class="board-step board-step-prev" href="#board-<%= prev.id %>" data-board-link="<%= (i + boards.length - 1) % boards.length %>" aria-label="<%= t('range.board_prev') %>: <%= prev.name %>"><span aria-hidden="true">‹</span><span class="board-step-name"><%= prev.name %></span></a>
          <div class="board-plank-title">
            <h3 id="board-<%= b.id %>-name"><%= b.name %></h3>
            <span class="board-plank-sub"><%= b.sub %><% if (b.total > 0) { %> · <%= t('range.mission_count').replace('{n}', b.total) %><% } %></span>
          </div>
          <a class="board-step board-step-next" href="#board-<%= next.id %>" data-board-link="<%= (i + 1) % boards.length %>" aria-label="<%= t('range.board_next') %>: <%= next.name %>"><span class="board-step-name"><%= next.name %></span><span aria-hidden="true">›</span></a>
        </header>
<% if (b.quest) { -%>
        <a class="quest-slip" href="<%= b.quest.href %>" data-testid="quest-card">
          <span class="quest-slip-kicker"><%= t('quest.board_kicker') %></span>
          <span class="quest-slip-title"><%= b.quest.title %></span>
          <span class="quest-slip-tagline"><%= b.quest.tagline %></span>
          <span class="quest-slip-foot"><span class="quest-slip-reward"><span class="coin" aria-hidden="true"></span><%= b.quest.reward %> <%= t('range.gold') %></span><span class="quest-slip-progress"><%= t('quest.progress').replace('{done}', b.quest.done).replace('{total}', b.quest.total) %></span><span class="btn btn-primary btn-sm"><%= t('quest.board_open') %></span></span>
        </a>
<% } -%>
<% if (b.cards.length > 0) { -%>
        <div class="catalog-grid">
<% b.cards.forEach(function (c) { -%>
          <a class="poster contract-slip lab-card lab-theme-<%= c.themeId %>" href="<%= c.href %>" data-testid="lab-card" data-lab="<%= c.id %>" data-difficulty="<%= c.difficulty %>" data-solved="<%= c.solved ? 'true' : 'false' %>" data-theme="<%= c.themeId %>"<% if (c.mode === 'team') { %> data-mode="team"<% } %>>
            <span class="poster-kicker" aria-hidden="true"><%= t('range.contract_word') %></span>
            <span class="poster-client"><%= t('range.client') %> · <%= c.app %></span>
            <h4 class="contract-app"><%= c.title %></h4>
            <p class="contract-objective"><%= c.scenario %></p>
            <span class="poster-tags"><span class="category-tab"><%= c.category %></span><% if (c.mode === 'team') { %><span class="badge team-mode-badge" data-mode="team"><%= t('range.team_mode') %></span><% } %></span>
            <ul class="tier-rows" aria-label="<%= t('range.tiers') %>">
<% c.levels.forEach(function (l) { -%>
              <li class="tier-row level-<%= l.id %><%= l.solved ? ' is-solved' : '' %>" aria-label="<%= l.label %>: <%= l.points %> <%= t('range.gold') %>"><span class="tier-seal" aria-hidden="true"></span><span class="tier-name"><%= l.label %></span></li>
<% }); -%>
            </ul>
            <span class="slip-foot">
              <span class="threat"><span class="threat-marks" aria-hidden="true"><%= '◆'.repeat(c.threat) + '◇'.repeat(4 - c.threat) %></span><span class="difficulty-label"><%= c.difficultyLabel %></span></span>
              <span class="bounty"><span class="sr-only"><%= t('range.bounty') %> </span><span class="bounty-figure"><%= c.bounty %></span> <%= t('range.gold') %></span>
            </span>
            <svg class="icon slip-ill" aria-hidden="true" focusable="false"><use href="/static/icons.svg#<%= c.icon %>"></use></svg>
<% if (c.solved) { -%>
            <span class="wax-seal" title="<%= t('challenge.solved_at').replace('{level}', c.bestLabel) %>"><span><%= t('range.sealed') %></span></span>
<% } -%>
          </a>
<% }); -%>
        </div>
<% } else if (!b.quest) { -%>
        <div class="board-empty">
          <span class="board-empty-pins" aria-hidden="true"><span></span><span></span><span></span></span>
          <p><%= b.total === 0 ? t('range.board_soon') : t('range.board_nomatch') %></p>
<% if (b.total > 0) { -%>
          <a class="btn btn-secondary btn-sm" href="/#board-<%= b.id %>"><%= t('range.empty_action') %></a>
<% } -%>
        </div>
<% } -%>
      </section>
<% }); -%>
    </div>
    <button type="button" class="board-nav board-nav-next" data-board-next hidden aria-label="<%= t('range.board_next') %>"><svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-arrow-right"></use></svg></button>
  </div>
</section>
<% if (needsAvatar) { -%>
<dialog class="preboard vn" data-preboard aria-labelledby="preboard-title" aria-describedby="preboard-text" data-testid="preboard">
  <span class="vn-mira" aria-hidden="true"><img class="mira-art" data-preboard-art src="/static/art/mira-point.webp" alt="" width="560" height="628" decoding="async"></span>
  <div class="vn-stack">
    <ul class="vn-choices" data-vn-choices aria-label="<%= t('avatar.invite_title') %>">
      <li><a class="vn-choice is-main" href="/adventurer" data-testid="preboard-go"><svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-quill"></use></svg><%= t('avatar.invite_go') %></a></li>
      <li><form method="post" action="/adventurer/skip"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit" class="vn-choice" data-testid="preboard-skip"><svg class="icon" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-arrow-right"></use></svg><%= t('avatar.skip') %></button></form></li>
    </ul>
    <div class="dialogue vn-box">
      <p class="dialogue-name"><span class="dialogue-speaker"><%= t('mira.name') %></span><span class="dialogue-role"><%= t('mira.role') %></span></p>
      <h2 class="sr-only" id="preboard-title"><%= t('avatar.invite_title') %></h2>
      <p class="dialogue-text" id="preboard-text" data-preboard-text><%= t('avatar.invite').replace('{name}', function () { return username; }) %></p>
      <span class="dialogue-more" aria-hidden="true"></span>
    </div>
  </div>
</dialog>
<% } -%>
<% if (gift) { -%>
<dialog class="gift-dialog" data-gift data-amount="<%= gift.amount %>" data-before="<%= gift.before %>" aria-labelledby="gift-title" aria-describedby="gift-text" data-testid="starter-gift">
  <div class="gift-slip">
    <div class="gift-confetti" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
    <svg class="gift-ill" viewBox="0 0 240 190" aria-hidden="true" focusable="false">
      <g class="gift-rays"><path d="M120 92 111 0h18z"/><path d="M120 92 111 0h18z" transform="rotate(30 120 92)"/><path d="M120 92 111 0h18z" transform="rotate(60 120 92)"/><path d="M120 92 111 0h18z" transform="rotate(-30 120 92)"/><path d="M120 92 111 0h18z" transform="rotate(-60 120 92)"/><path d="M120 92 111 0h18z" transform="rotate(90 120 92)"/><path d="M120 92 111 0h18z" transform="rotate(-90 120 92)"/></g>
      <circle class="gift-glow" cx="120" cy="96" r="66"/>
      <g class="gift-rise">
        <g class="gift-c gift-c1"><ellipse class="gc-rim" cx="104" cy="64" rx="12" ry="5.5"/><ellipse class="gc-face" cx="104" cy="62" rx="12" ry="5.5"/></g>
        <g class="gift-c gift-c2"><ellipse class="gc-rim" cx="122" cy="56" rx="12" ry="5.5"/><ellipse class="gc-face" cx="122" cy="54" rx="12" ry="5.5"/></g>
        <g class="gift-c gift-c3"><ellipse class="gc-rim" cx="139" cy="64" rx="12" ry="5.5"/><ellipse class="gc-face" cx="139" cy="62" rx="12" ry="5.5"/></g>
      </g>
      <g class="gift-pouch">
        <path class="pouch-frill" d="M86 80c-6-15 10-21 17-11 3-13 31-13 34 0 7-10 23-4 17 11z"/>
        <path class="pouch-body" d="M80 92c-28 20-30 74 6 88 18 7 50 7 68 0 36-14 34-68 6-88z"/>
        <path class="pouch-shade" d="M150 100c22 22 22 64-4 76 14-18 16-52 4-76z"/>
        <path class="pouch-neck" d="M84 78c12-7 60-7 72 0l6 14c-22 8-62 8-84 0z"/>
        <path class="pouch-cord" d="M80 92c20 8 60 8 80 0M120 99c-5 12-11 18-17 24M120 99c6 13 13 19 19 25"/>
        <circle class="pouch-knot" cx="120" cy="98" r="5"/>
        <circle class="pouch-seal" cx="120" cy="144" r="17"/>
        <path class="pouch-mark" d="M126 137a10 10 0 1 0 1 13v-6h-7"/>
      </g>
      <g class="gift-spill">
        <ellipse class="gc-rim" cx="58" cy="178" rx="13" ry="5"/><ellipse class="gc-face" cx="58" cy="176" rx="13" ry="5"/>
        <ellipse class="gc-rim" cx="76" cy="184" rx="11" ry="4.5"/><ellipse class="gc-face" cx="76" cy="182" rx="11" ry="4.5"/>
        <ellipse class="gc-rim" cx="176" cy="182" rx="13" ry="5"/><ellipse class="gc-face" cx="176" cy="180" rx="13" ry="5"/>
        <ellipse class="gc-rim" cx="186" cy="173" rx="11" ry="4.5"/><ellipse class="gc-face" cx="186" cy="171" rx="11" ry="4.5"/>
      </g>
      <g class="gift-sparks"><path d="m42 52 3 9 9 3-9 3-3 9-3-9-9-3 9-3z"/><path d="m196 40 2 6 6 2-6 2-2 6-2-6-6-2 6-2z"/><path d="m206 112 2 5 5 2-5 2-2 5-2-5-5-2 5-2z"/><path d="m30 124 2 5 5 2-5 2-2 5-2-5-5-2 5-2z"/></g>
    </svg>
    <p class="gift-eyebrow"><%= t('gift.eyebrow') %></p>
    <h2 class="gift-title" id="gift-title"><%= t('gift.title') %></h2>
    <p class="gift-amount"><span class="coin" aria-hidden="true"></span><b data-gift-count><%= t('gift.amount').replace('{n}', gift.amount) %></b></p>
    <p class="gift-what"><%= t('gift.what') %></p>
    <div class="gift-say">
      <span class="gift-face" aria-hidden="true"><img src="/static/art/mira-cheer.webp" alt="" width="560" height="628" decoding="async"></span>
      <p class="gift-text" id="gift-text"><b class="gift-speaker"><%= t('mira.name') %></b> <%= t('gift.line').replace('{name}', function () { return username; }).replace('{scroll}', function () { return gift.scroll; }) %></p>
    </div>
    <p class="gift-tip"><%= t('gift.tip') %></p>
    <div class="gift-actions">
      <form method="dialog"><button type="submit" class="btn btn-primary btn-block" data-gift-ok data-testid="gift-ok"><%= t('gift.ok') %></button></form>
      <a class="btn btn-secondary btn-block" href="/shop" data-testid="gift-shop"><%= t('gift.shop') %></a>
    </div>
  </div>
</dialog>
<% } -%>
<template id="tour-steps" data-tour="hall">
  <p data-pose="smile"><%= t('tour.c1').replace('{name}', function () { return username; }) %></p>
  <p data-pose="point" data-target=".licence"><%= t('tour.c2') %></p>
  <p data-pose="point" data-target=".board-signs"><%= t('tour.c3') %></p>
  <p data-pose="smile" data-target=".lab-card"><%= t('tour.c4') %></p>
  <p data-pose="think" data-target=".range-filters"><%= t('tour.c5') %></p>
  <p data-pose="point" data-target="[data-testid=nav-leaderboard]"><%= t('tour.c6') %></p>
  <p data-pose="point" data-target="[data-testid=nav-shop]"><%= t('tour.c9') %></p>
  <p data-pose="smile" data-target="[data-sound-toggle]"><%= t('tour.c7') %></p>
  <p data-pose="cheer" data-target=".reception"><%= t('tour.c8') %></p>
</template>
