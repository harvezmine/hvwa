<h1 class="page-title"><%= t('portal.heading') %></h1>
<% if (districts.length === 0) { %>
  <p class="muted"><%= t('portal.no_challenges') %></p>
<% } %>
<div class="district-grid">
<% districts.forEach(function (d) { %>
  <section class="card district" data-district="<%= d.id %>">
    <h2 class="district-name"><%= d.id %>
      <span class="muted small">(<%= d.challenges.length %> <%= t('portal.challenges') %>)</span>
    </h2>
    <ul class="challenge-list">
    <% d.challenges.forEach(function (c) { %>
      <li>
        <a href="/c/<%= c.id %>">
          <span class="challenge-id"><%= c.id %></span>
          — <%= c.title[lang] %>
        </a>
        <span class="muted">[<%= c.levels.join(', ') %>]</span>
      </li>
    <% }); %>
    </ul>
  </section>
<% }); %>
</div>
