<h1 class="text-2xl font-bold mb-6"><%= t('scoreboard.title') %></h1>
<div class="flex gap-6">
  <div class="border border-slate-800 rounded-lg p-6 min-w-[8rem]">
    <div class="text-slate-400 text-sm"><%= t('scoreboard.score') %></div>
    <div class="text-4xl font-bold text-amber-400"><%= score %></div>
  </div>
  <div class="border border-slate-800 rounded-lg p-6 min-w-[8rem]">
    <div class="text-slate-400 text-sm"><%= t('scoreboard.solved') %></div>
    <div class="text-4xl font-bold"><%= solved %></div>
  </div>
</div>
