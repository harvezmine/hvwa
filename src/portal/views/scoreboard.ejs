<h1 class="page-title"><%= t('scoreboard.title') %></h1>
<div class="stat-row">
  <div class="card stat">
    <div class="stat-label"><%= t('scoreboard.score') %></div>
    <div class="stat-value accent" data-testid="score"><%= score %></div>
  </div>
  <div class="card stat">
    <div class="stat-label"><%= t('scoreboard.solved') %></div>
    <div class="stat-value" data-testid="solved"><%= solved %></div>
  </div>
</div>
