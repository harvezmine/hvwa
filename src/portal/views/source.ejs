<h1 class="page-title"><span class="challenge-id"><%= c.id %></span> — <%= c.title[lang] %></h1>
<p><a href="/c/<%= c.id %>"><%= t('challenge.back') %></a></p>
<% if (diff !== undefined) { %>
  <%- diff %>
<% } else { %>
  <h2><%= t('level.' + srcLevel) %></h2>
  <pre class="source-view"><code><%= src %></code></pre>
<% } %>
