<%# Change password (src/auth). Each error is shown under the field it is about (data-error is the closed error key); no
   submitted value is ever echoed. Split surface like the login. Every value goes through the escaped output tag. Never
   put an EJS tag inside an EJS comment: it breaks parsing. %>
<%
  var errCurrent = error === 'current';
  var errNew = ['too_short', 'too_long', 'control', 'same', 'default'].indexOf(error) !== -1;
  var errConfirm = error === 'mismatch';
-%>
<div class="auth-shell">
  <aside class="auth-brand">
    <img class="auth-logo" src="/static/brand/logo.png" alt="" width="800" height="533">
    <svg class="icon auth-ill" aria-hidden="true" focusable="false"><use href="/static/icons.svg#i-key-seal"></use></svg>
    <p class="auth-statement"><%= t('auth.brand_statement') %></p>
    <ul class="auth-facts">
      <li><%= t('auth.fact_isolated') %></li>
      <li><%= t('auth.fact_containers') %></li>
      <li><%= t('auth.fact_flags') %></li>
    </ul>
  </aside>
  <section class="auth-panel" aria-labelledby="pw-title">
    <h1 class="page-title" id="pw-title"><%= t('auth.pw_heading') %></h1>
    <p class="auth-intro"><%= t('auth.pw_rules') %></p>
<% if (changed) { -%>
    <p class="result result-ok" role="status" data-testid="password-changed"><%= t('auth.pw_changed') %></p>
<% } -%>
<% if (notice) { -%>
    <p class="result result-bad" role="alert" data-testid="auth-busy"><%= notice %></p>
<% } -%>
<% if (error && !errCurrent && !errNew && !errConfirm) { -%>
    <p class="result result-bad" role="alert" data-error="<%= error %>"><%= t('auth.pw_err_' + error).replace('{n}', pwMin) %></p>
<% } -%>
    <form method="post" action="/account/password" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="text" name="username" value="<%= user %>" autocomplete="username" hidden>
      <div class="field">
        <label for="pw-current"><%= t('auth.pw_current') %></label>
        <input id="pw-current" type="password" name="current" autocomplete="current-password" maxlength="1024" required<% if (errCurrent) { %> aria-invalid="true" aria-describedby="pw-current-error"<% } %>>
<% if (errCurrent) { -%>
        <p class="result result-bad field-error" role="alert" id="pw-current-error" data-error="<%= error %>"><%= t('auth.pw_err_' + error).replace('{n}', pwMin) %></p>
<% } -%>
      </div>
      <div class="field">
        <label for="pw-new"><%= t('auth.pw_new') %></label>
        <input id="pw-new" type="password" name="password" autocomplete="new-password" minlength="<%= pwMin %>" maxlength="1024" required data-strength="pw-strength" aria-describedby="pw-new-help<% if (errNew) { %> pw-new-error<% } %>"<% if (errNew) { %> aria-invalid="true"<% } %>>
        <p class="help" id="pw-new-help"><%= t('auth.pw_new_help').replace('{n}', pwMin) %></p>
        <p class="strength" id="pw-strength" hidden aria-live="polite" data-label-weak="<%= t('auth.pw_strength_weak') %>" data-label-fair="<%= t('auth.pw_strength_fair') %>" data-label-strong="<%= t('auth.pw_strength_strong') %>"><span><%= t('auth.pw_strength') %>:</span><span class="strength-bar" aria-hidden="true"><span></span><span></span><span></span></span><span data-strength-value></span></p>
<% if (errNew) { -%>
        <p class="result result-bad field-error" role="alert" id="pw-new-error" data-error="<%= error %>"><%= t('auth.pw_err_' + error).replace('{n}', pwMin) %></p>
<% } -%>
      </div>
      <div class="field">
        <label for="pw-confirm"><%= t('auth.pw_confirm') %></label>
        <input id="pw-confirm" type="password" name="confirm" autocomplete="new-password" minlength="<%= pwMin %>" maxlength="1024" required<% if (errConfirm) { %> aria-invalid="true" aria-describedby="pw-confirm-error"<% } %>>
<% if (errConfirm) { -%>
        <p class="result result-bad field-error" role="alert" id="pw-confirm-error" data-error="<%= error %>"><%= t('auth.pw_err_' + error).replace('{n}', pwMin) %></p>
<% } -%>
      </div>
      <button type="submit" class="btn btn-primary btn-lg btn-block"><%= t('auth.pw_button') %></button>
    </form>
  </section>
</div>
