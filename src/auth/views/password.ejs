<h1 class="page-title"><%= t('auth.pw_heading') %></h1>
<section class="card panel auth-card">
<% if (changed) { -%>
  <p class="result result-ok" role="status" data-testid="password-changed"><%= t('auth.pw_changed') %></p>
<% } -%>
<% if (notice) { -%>
  <p class="result result-bad" role="alert" data-testid="auth-busy"><%= notice %></p>
<% } -%>
<% if (error) { -%>
  <p class="result result-bad" role="alert" data-error="<%= error %>"><%= t('auth.pw_err_' + error) %></p>
<% } -%>
  <p class="muted small"><%= t('auth.pw_rules') %></p>
  <form method="post" action="/account/password" class="auth-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="text" name="username" value="<%= user %>" autocomplete="username" hidden>
    <label><%= t('auth.pw_current') %>
      <input type="password" name="current" autocomplete="current-password" maxlength="1024" required>
    </label>
    <label><%= t('auth.pw_new') %>
      <input type="password" name="password" autocomplete="new-password" minlength="8" maxlength="1024" required>
    </label>
    <label><%= t('auth.pw_confirm') %>
      <input type="password" name="confirm" autocomplete="new-password" minlength="8" maxlength="1024" required>
    </label>
    <button type="submit"><%= t('auth.pw_button') %></button>
  </form>
</section>
